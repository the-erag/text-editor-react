{
    "name": "@erag/text-editor-react",
    "version": "1.1.0",
    "description": "A modern dependency-free React rich text editor (WYSIWYG) built with native browser APIs. Supports TypeScript, mentions, merge tags, templates, image upload, tables, HTML editing, and customizable toolbars.",
    "type": "module",
    "license": "MIT",
    "author": {
        "name": "Er Amit Gupta",
        "url": "https://github.com/eramitgupta"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/the-erag/text-editor-react.git"
    },
    "bugs": {
        "url": "https://github.com/the-erag/text-editor-react/issues"
    },
    "homepage": "https://erag.in/text-editor-react/index.html",
    "keywords": [
        "react",
        "react-editor",
        "react-rich-text-editor",
        "react-wysiwyg",
        "rich-text-editor",
        "text-editor",
        "wysiwyg",
        "wysiwyg-editor",
        "html-editor",
        "contenteditable",
        "typescript",
        "dependency-free",
        "zero-dependencies",
        "native-browser-api",
        "open-source",
        "free",
        "pro-features",
        "enterprise-ready",
        "customizable",
        "toolbar",
        "mentions",
        "merge-tags",
        "templates",
        "email-templates",
        "image-upload",
        "media-upload",
        "table-editor",
        "document-editor",
        "email-editor",
        "cms-editor",
        "nextjs",
        "vite"
    ],
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "main": "./dist/text-editor-react.js",
    "module": "./dist/text-editor-react.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/text-editor-react.js"
        },
        "./style.css": "./dist/style.css"
    },
    "sideEffects": [
        "**/*.css"
    ],
    "scripts": {
        "dev": "vite build --watch",
        "build": "vite build",
        "release": "release-it",
        "release:dry": "release-it --dry-run",
        "lint": "prettier --write src eslint.config.js vite.config.ts package.json \"*.md\" \".github/**/*.md\" && eslint src vite.config.ts --fix",
        "lint:check": "prettier --check src eslint.config.js vite.config.ts package.json \"*.md\" \".github/**/*.md\" && eslint src vite.config.ts",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "prepublishOnly": "npm run lint:check && npm run typecheck && npm run build"
    },
    "peerDependencies": {
        "react": ">=18.0.0 <20",
        "react-dom": ">=18.0.0 <20"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.0",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.0.0",
        "eslint": "^9.39.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.0.0",
        "globals": "^16.0.0",
        "prettier": "^3.6.2",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "release-it": "^21.0.1",
        "typescript": "^5.9.0",
        "typescript-eslint": "^8.46.0",
        "vite": "^8.0.0",
        "vite-plugin-dts": "^5.0.0"
    },
    "engines": {
        "node": ">=24.0.0"
    }
}
